@model MultiPortalSchoolSys.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Update Password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="card auth-card mx-auto">
    <div class="card-body p-5">
        <div class="text-center mb-4">
            <div class="mb-3">
                <i class="bi bi-shield-lock" style="font-size: 2.5rem; color: var(--school-accent);"></i>
            </div>
            <h4 class="fw-bold" style="color: var(--school-primary)">Secure Your Account</h4>
            <p class="small text-secondary">Please update your temporary password to continue to your portal.</p>
        </div>

        <form asp-action="ChangePassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3" role="alert"></div>

            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label small fw-bold text-secondary">Current Password</label>
                <div class="input-group">
                    <input asp-for="CurrentPassword" type="password" class="form-control" placeholder="Enter current password" />
                </div>
                <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
            </div>

            <hr class="my-4 text-secondary opacity-25">

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label small fw-bold text-secondary">New Password</label>
                <input asp-for="NewPassword" type="password" class="form-control" placeholder="Minimum 6 characters" />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                <div class="form-text small">Use a mix of letters, numbers, and symbols.</div>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label small fw-bold text-secondary">Confirm New Password</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Repeat new password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-school w-100 mb-3" id="changePwdBtn">
                Update & Access Portal
            </button>

            <div class="text-center">
                <a asp-action="Logout" class="small text-decoration-none text-secondary">
                    <i class="bi bi-box-arrow-left"></i> Cancel and Sign Out
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $('form').on('submit', function () {
                if ($(this).valid()) {
                    $('#changePwdBtn').prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Updating...');
                }
            });
        });
    </script>
}