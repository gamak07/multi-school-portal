@model MultiPortalSchoolSys.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="card auth-card mx-auto">
    <div class="card-body p-5">
        <div class="text-center mb-4">
            <div class="mb-3">
                <span class="h2 fw-bold" style="color: var(--school-primary)">MPSMS</span>
            </div>
            <h5 class="text-muted">Welcome back!</h5>
            <p class="small text-secondary">Please sign in to your portal</p>
        </div>

        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label small fw-bold text-secondary"></label>
                <input asp-for="Email" class="form-control form-control-lg fs-6" placeholder="name@school.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between">
                    <label asp-for="Password" class="form-label small fw-bold text-secondary"></label>
                    <a href="#" class="small text-decoration-none" style="color: var(--school-accent)">Forgot password?</a>
                </div>
                <input asp-for="Password" type="password" class="form-control form-control-lg fs-6"
                       placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label small text-secondary"></label>
            </div>

            <button type="submit" class="btn btn-school w-100 mb-3" id="loginBtn">
                Sign In
            </button>
        </form>

        <div class="text-center">
            <p class="small text-muted mb-0">Don't have an account?</p>
            <p class="small fw-bold" style="color: var(--school-primary)">Contact the School Admin</p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $('form').on('submit', function () {
                if ($(this).valid()) {
                    $('#loginBtn').prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Signing in...');
                }
            });
        });
    </script>
}